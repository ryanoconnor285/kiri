{
  "name": "kiri",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "pnpm --filter @kiri/schema build && pnpm --filter @kiri/db build && pnpm --filter @kiri/api build",
    "start": "node apps/api/dist/index.js",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @kiri/db generate",
    "db:migrate": "pnpm --filter @kiri/db migrate",
    "db:studio": "pnpm --filter @kiri/db studio",
    "db:seed": "pnpm --filter @kiri/api seed"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  }
}
