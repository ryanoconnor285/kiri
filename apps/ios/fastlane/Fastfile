# frozen_string_literal: true

default_platform(:ios)

def app_store_api_key
  key_path = ENV["APPSTORE_KEY_PATH"]
  if key_path && File.exist?(key_path)
    return app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_filepath: key_path,
      duration: 1200,
      in_house: false,
    )
  end

  app_store_connect_api_key(
    key_id: ENV.fetch("APPSTORE_KEY_ID"),
    issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
    key_content: ENV.fetch("APPSTORE_PRIVATE_KEY"),
    duration: 1200,
    in_house: false,
  )
end

def import_manual_signing_material
  return unless ENV["IOS_DISTRIBUTION_CERTIFICATE_BASE64"]

  cert_path = File.join(Dir.tmpdir, "kiri_distribution.p12")
  File.binwrite(cert_path, Base64.decode64(ENV["IOS_DISTRIBUTION_CERTIFICATE_BASE64"]))
  import_certificate(
    certificate_path: cert_path,
    certificate_password: ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_PASSWORD"),
    keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain-db"),
  )

  return unless ENV["IOS_PROVISIONING_PROFILE_BASE64"]

  profile_path = File.join(Dir.tmpdir, "kiri_appstore.mobileprovision")
  File.binwrite(profile_path, Base64.decode64(ENV["IOS_PROVISIONING_PROFILE_BASE64"]))
  @installed_profile_name = install_provisioning_profile(path: profile_path)
end

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Release-optimized build with staging API → TestFlight"
  lane :testflight_staging do
    api_key = app_store_api_key
    team = ENV.fetch("DEVELOPMENT_TEAM")

    if ENV["MATCH_GIT_URL"]
      match(
        type: "appstore",
        readonly: true,
        api_key: api_key,
        git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      )
      profile_name = ENV.fetch("sigh_app.kiri.study_appstore_profile-name") do
        mapping = Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
        mapping&.fetch("app.kiri.study") ||
          UI.user_error!("Missing App Store profile name after match")
      end
    else
      import_manual_signing_material
      profile_name = @installed_profile_name || ENV.fetch("IOS_PROVISIONING_PROFILE_NAME")
      UI.user_error!("Set MATCH_GIT_URL or IOS_PROVISIONING_PROFILE_* secrets") if profile_name.to_s.empty?
    end

    build_number = ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s)
    increment_build_number(
      build_number: build_number,
      xcodeproj: "Kiri.xcodeproj",
    )

    # gym/build_app has no api_key option; match already installed cert + profile on CI.
    escaped_profile = profile_name.gsub("'", "'\\''")
    build_app(
      scheme: "Kiri-Staging",
      configuration: "ReleaseStaging",
      export_method: "app-store",
      export_team_id: team,
      xcargs: [
        "DEVELOPMENT_TEAM=#{team}",
        "CODE_SIGN_STYLE=Manual",
        "PROVISIONING_PROFILE_SPECIFIER='#{escaped_profile}'",
        "CODE_SIGN_IDENTITY=Apple Distribution",
      ].join(" "),
      export_options: {
        provisioningProfiles: {
          "app.kiri.study" => profile_name,
        },
      },
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
