# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kiri

# API
PORT=4000
NODE_ENV=development
BETTER_AUTH_SECRET=dev-secret-change-in-production-min-32-chars
# API_URL: this API service's own public base URL.
API_URL=http://localhost:4000
# WEB_URL: the web app's origin (used as the CORS allowed origin).
WEB_URL=http://localhost:3000

# OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Web (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000
